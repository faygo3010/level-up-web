# Copy to .env.local for local dev, and set the same two values on Render.
# Both are safe to ship to the browser: the anon key only works within the
# row-level security rules in supabase/migrations/001_user_state.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
